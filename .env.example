# T-800 Trader does not custody keys. Never put a mnemonic or private key here.

# Optional browser/build-time Solana JSON-RPC (balances, decimals, confirm).
# NEXT_PUBLIC_SOLANA_RPC=https://solana.publicnode.com

# Optional Jupiter Swap API (quote + unsigned tx). Default is the keyless lite host.
# NEXT_PUBLIC_JUPITER_API=https://lite-api.jup.ag/swap/v1

# Optional Ultra host used to sponsor network fees when a close would otherwise need 0.005 SOL.
# NEXT_PUBLIC_JUPITER_ULTRA_API=https://lite-api.jup.ag/ultra/v1

# Optional Jupiter key if you point NEXT_PUBLIC_JUPITER_API at api.jup.ag.
# This is still a public client key — it is not a wallet secret.
# NEXT_PUBLIC_JUPITER_API_KEY=
