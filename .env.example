# T-800 Trader does not custody keys and does not send live swaps.
# No mnemonic, private key, or RPC API secret is required.

# Optional browser/build-time Solana JSON-RPC override (read-only balances + health).
# When unset, the client falls back to PublicNode.
# NEXT_PUBLIC_SOLANA_RPC=https://solana.publicnode.com
